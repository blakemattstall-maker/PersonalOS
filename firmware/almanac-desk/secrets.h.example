// Copy this file to secrets.h and fill it in. secrets.h is gitignored —
// the repo is public, so nothing real ever goes in this .example.
#pragma once

// 2.4GHz only — the ESP32-S3 cannot see 5GHz networks, and campus
// WPA2-Enterprise (eduroam) is not supported here. Dorm router or hotspot.
#define WIFI_SSID     "your-network"
#define WIFI_PASSWORD "your-password"

// The Almanac deployment and its device key (API_SECRET on Vercel).
#define API_BASE "https://your-deployment.vercel.app"
#define API_KEY  "your-api-secret"

// POSIX TZ string for the clock. America/Chicago:
#define TZ_INFO "CST6CDT,M3.2.0,M11.1.0"
